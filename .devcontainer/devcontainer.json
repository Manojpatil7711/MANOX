{
  "name": "MANOX Flutter Codespace",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/MANOX",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/MANOX,type=bind,consistency=cached",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "ms-vscode.cpptools"
      ]
    }
  },
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  }
}
